<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DepGraph</RootNamespace>
    <AssemblyName>depgraph</AssemblyName>
    <Version>0.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Build an AI-agent-readable dependency graph, and Markdown docs per entity, from a zip of tabular extracts (Salesforce .csv/.xlsx and friends).</Description>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>depgraph</ToolCommandName>
    <PackageId>DepGraph</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Sep" Version="0.17.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DepGraph.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Column statistics that outgrow a file's memory go to disk, and what they held
         becomes garbage the runtime would otherwise keep for a long time: with 11 files
         read under a 2 GB budget the process peaked at 3.0 GB, and at 1.6 GB with this. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>
